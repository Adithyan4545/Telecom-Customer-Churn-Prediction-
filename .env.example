# MongoDB Connection
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=telecom_churn

# JWT Secret & Auth
JWT_SECRET=super-secret-telecom-jwt-key-for-development-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Administrator Account (Auto-created during setup)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@telecom.com
ADMIN_PASSWORD=admin123

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
